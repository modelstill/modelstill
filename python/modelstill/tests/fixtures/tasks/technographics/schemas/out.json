{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["technologies"],
  "properties": {
    "technologies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "strength"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "strength": {"enum": ["required", "preferred", "mentioned"]}
        }
      }
    }
  }
}
