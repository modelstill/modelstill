{
  "name": "modelstill",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "oxlint",
    "format": "bunx --bun oxlint --fix --fix-suggestions",
    "cleanup": "turbo cleanup && rimraf node_modules bun.lock .turbo",
    "prepare": "husky"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.7",
    "@types/bun": "1.2.8",
    "dotenv": "^16.5.0",
    "husky": "9.1.7",
    "lint-staged": "15.5.0",
    "oxlint": "0.16.4",
    "rimraf": "6.0.1",
    "tsup": "8.5.0",
    "turbo": "2.4.4",
    "typescript": "5.8.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "lint-staged": {
    "**/*.{js,mjs,cjs,jsx,ts,tsx}": "oxlint --fix"
  }
}
